<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.armaanseth.internship-verifier</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/armaanseth/jobagent-early-warning/discover_and_alert.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/armaanseth/jobagent-early-warning</string>

  <!-- Runs at load, then at fixed clock hours every 3 hours. StartInterval
       (the old approach) is relative to whenever the job was last loaded,
       so it drifts and can wander away from covering a given hour entirely;
       StartCalendarInterval pins it to real wall-clock times and launchd
       still fires it immediately on wake if the machine was asleep through
       one of them, instead of just skipping that slot for good. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/armaanseth/jobagent-early-warning/launchd/verifier.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/armaanseth/jobagent-early-warning/launchd/verifier.log</string>
</dict>
</plist>
