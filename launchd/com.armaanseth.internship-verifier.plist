<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.armaanseth.internship-verifier</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/armaanseth/jobagent-early-warning/verify_and_alert.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/armaanseth/jobagent-early-warning</string>

  <!-- Runs at load, then every 4 hours. Fires on wake if a run was missed. -->
  <key>StartInterval</key>
  <integer>14400</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/armaanseth/jobagent-early-warning/launchd/verifier.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/armaanseth/jobagent-early-warning/launchd/verifier.log</string>
</dict>
</plist>
